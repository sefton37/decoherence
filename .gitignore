# Python virtual environment
venv/
.venv/

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Testing
.pytest_cache/
.coverage
htmlcov/

# Godot 4 (Decoherence Phase 0, Spec #370)
.godot/
*.translation
export.pck
export.zip
*.tmp

# Godot re-derives *.import metadata (incl. a content-hashed cache filename
# under .godot/imported/, itself gitignored above) automatically on first
# project scan -- not needed for reproducibility on this solo project, and
# committing it would embed a 32-hex-char cache hash that reads as a secret
# to generic content-scanning (it isn't one).
*.import

# Decoherence game-owned llama-server substrate (Spec #387). Staged by
# tools/setup_llm.sh -- the llama-server binary + sibling libraries and
# the GGUF model live here, self-contained under the repo, never tracked.
llm/
.claude/hooks/logs/

# Spec #494 GDExtension toolchain + build output (tools/setup_gdext.sh)
engine/spike/ext/godot-cpp/
engine/spike/ext/bin/
engine/spike/ext/.sconsign.dblite
*.so
*.os
*.o
*.a
