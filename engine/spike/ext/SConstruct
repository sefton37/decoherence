#!/usr/bin/env python
# Spec #494 spike: builds libstalagspike.<platform>.<target>.<arch>.so into ./bin
# godot-cpp is fetched by tools/setup_gdext.sh (gitignored). -ffp-contract=off keeps
# the double-precision noise bit-identical to the JS reference (no fused multiply-add).
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
env.Append(CXXFLAGS=["-ffp-contract=off"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/libstalagspike{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
