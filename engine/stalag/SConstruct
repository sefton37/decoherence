#!/usr/bin/env python
# Spec #501: builds libstalag.<platform>.<target>.<arch>.so into ./bin.
# godot-cpp is fetched by tools/build_engine.sh (gitignored). -ffp-contract=off keeps
# the double-precision noise bit-identical to the JS reference (no fused multiply-add).
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
env.Append(CXXFLAGS=["-ffp-contract=off"])
# Spec #517: the plan solve reports a failed invariant by throwing inside stalag_plan.cpp
# (caught there, never crossing into Godot); godot-cpp defaults to -fno-exceptions.
env.Append(CXXFLAGS=["-fexceptions"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/libstalag{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
