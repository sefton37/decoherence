; Engine configuration file.
; It's best edited using the editor UI and not directly, since the parameters
; that go here are not all obvious.
;
; Decoherence Phase 0 (Spec #370 / plan-370): Q-Ent boot TUI + LLM-powered
; Handler. Final version -- overwrites the tester's Phase-0 placeholder.
; Registers the same two tester-owned autoloads (Signals, ProbeDriver) and
; points run/main_scene at the real scenes/boot.tscn (terminal renderer,
; boot-sequence driver, LLM client, Handler chat, CRT overlay).

config_version=5

[application]

config/name="Decoherence"
run/main_scene="res://frontdoor/scenes/boot.tscn"
config/features=PackedStringArray("4.5")

[autoload]

Signals="*res://frontdoor/scripts/signal_bus.gd"
ProbeDriver="*res://frontdoor/scripts/probe_driver.gd"
PauseMenu="*res://frontdoor/scripts/pause_menu.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

; Spec #549: the forest's crowns run a heavy per-vertex wind shader. The depth pre-pass runs every
; vertex shader twice (once for depth, once for colour) and buys nothing here, where fragments are
; cheap: measured on the perf walk it halves the crown cost without changing a pixel.
driver/depth_prepass/enable=false
